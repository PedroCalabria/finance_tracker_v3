# Copie para .env e ajuste. Nunca suba o .env para o git.
# Ver docs/decisions/0008-infraestrutura-e-operacao.md

NODE_ENV=development
PORT=3000
# Endereço público da interface (usado nos links dos emails).
APP_URL=http://localhost:5173
DATABASE_URL=postgres://financas:financas@localhost:5432/financas

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Chave dos comprovantes: 32 bytes em base64.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GUARDE UMA CÓPIA NUM GERENCIADOR DE SENHAS: perder a chave = perder todos os comprovantes.
ATTACHMENTS_KEY=

# Em produção atrás do proxy do CloudPanel:
# TRUST_PROXY=true
# COOKIE_SECURE=true
# WEB_DIST=/app/apps/web/dist

# Comprovantes: "local" (pasta) em desenvolvimento, "s3" (Cloudflare R2) em produção.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=financas-comprovantes
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Emails: "console" mostra no terminal (com os links); "resend" envia de verdade.
EMAIL_DRIVER=console
# RESEND_API_KEY=
# EMAIL_FROM=Finanças da Família <avisos@avisos.seudominio.com.br>

# Backup (scripts/backup.sh, só na VPS). Ver docs/operacao.md.
# POSTGRES_PASSWORD=troque-esta-senha
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_RCLONE_REMOTE=r2-backup:financas-backups
# BACKUP_ALERT_TO=seu-email@exemplo.com
