{
  "name": "@ff/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main-api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/main-worker.ts",
    "build": "tsup",
    "start": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/main-migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.3.0",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.44.7",
    "fastify": "5.12.8",
    "file-type": "21.3.4",
    "heic-convert": "2.1.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "pg-boss": "10.4.2",
    "pino": "9.14.0",
    "sharp": "0.34.5",
    "unpdf": "1.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
